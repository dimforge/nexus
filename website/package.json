{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "node scripts/start-with-guides.mjs",
    "build": "docusaurus build",
    "build:demos": "./scripts/build-demos.sh",
    "build:demo": "./scripts/build-demos.sh",
    "build:all": "npm run build:demos && npm run build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "prebuild": "npm run docs:generate",
    "docs:generate": "node scripts/generate-user-guides.mjs",
    "docs:test": "node --test scripts/user-guides.test.mjs",
    "docs:check:rust": "cargo check --manifest-path ../Cargo.toml -p nexus-guide-2d -p nexus-guide-3d --all-targets",
    "docs:check:python": "python3 docs-examples/python/check.py",
    "docs:check": "npm run docs:test && npm run docs:check:rust && npm run docs:check:python",
    "docs:test:cpu": "cargo test --release --manifest-path ../Cargo.toml -p nexus-guide-2d -p nexus-guide-3d --features cpu"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
